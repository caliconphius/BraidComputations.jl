#!/usr/bin/env bash
set -euo pipefail
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export JULIA_DEPOT_PATH="$project_dir/.depot:${JULIA_DEPOT_PATH:-$HOME/.julia}"
export JULIA_NUM_PRECOMPILE_TASKS="${JULIA_NUM_PRECOMPILE_TASKS:-1}"
exec julia --startup-file=no --project="$project_dir" "$@"
